{
    "name": "@jsprismarine/proxy",
    "version": "0.14.2",
    "private": true,
    "description": "Minecraft: Bedrock Edition proxy that relays a client to a server and records the traffic",
    "sideEffects": false,
    "type": "module",
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "main": "./dist/index.cjs.cjs",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "jsp-proxy": "./dist/cli.es.js"
    },
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist jsp *.tsbuildinfo vite.config.ts.timestamp-* .tsup .turbo",
        "build": "vite build && node ../../scripts/emit-dts.mts",
        "build:watch": "vite build --watch",
        "start": "node --import tsx ./src/cli.ts",
        "typecheck": "tsc-ts --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JSPrismarine/JSPrismarine.git"
    },
    "keywords": [
        "minecraft",
        "bedrock",
        "proxy",
        "raknet"
    ],
    "author": "JSPrismarine",
    "license": "MIT",
    "homepage": "https://github.com/JSPrismarine/JSPrismarine/tree/master/packages/proxy",
    "devDependencies": {
        "@jsprismarine/prismarine": "workspace:*",
        "@types/node": "24.13.6",
        "@types/yargs": "17.0.35",
        "glob": "13.0.6",
        "rimraf": "6.1.3",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.3",
        "vitest": "5.0.1"
    },
    "dependencies": {
        "@jsprismarine/auth": "workspace:*",
        "@jsprismarine/client": "workspace:*",
        "@jsprismarine/logger": "workspace:*",
        "@jsprismarine/protocol": "workspace:*",
        "@jsprismarine/raknet": "workspace:*",
        "yargs": "18.2.0"
    }
}
